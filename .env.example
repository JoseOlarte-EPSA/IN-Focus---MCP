# ════════════════════════════════════════════════════════════════
# IN Focus MCP — Variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# ════════════════════════════════════════════════════════════════

# ── Servidor MCP ────────────────────────────────────────────────
SERVER_NAME=IN Focus MCP
SERVER_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
MCP_PATH=/mcp
MCP_TRANSPORT=streamable-http

# Modulo de autenticacion: 'none' o 'bearer'.
MCP_AUTH_MODE=none
# Token obligatorio solo cuando MCP_AUTH_MODE=bearer.
MCP_BEARER_TOKEN=cambia-este-token

# ── Base de datos GRANTS (SQL Server / Azure SQL) ───────────────
# Nombres exactos que lee clients/grants_client.py.
GRANTS_SERVER=tu-servidor.database.windows.net
GRANTS_DATABASE=Apps_Grants
GRANTS_USERNAME=usuario
GRANTS_PASSWORD=contra

# Opcional. Por defecto: ODBC Driver 18 for SQL Server
SQL_DRIVER=ODBC Driver 18 for SQL Server
